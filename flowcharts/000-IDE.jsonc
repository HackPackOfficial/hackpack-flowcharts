
{
    "id": "IDE",
    "title": "IDE Troubleshooting",
    "description": "Interactive guide to solve common IDE issues",
    "startingQuestion": "Title",
    "color": "#57899E",
    "renderOptions": { "layout": "elk" },
    "questions": {

        "Title": {
            "question": "Which problem are you having?",
            "answers": [
                {
                    "answer": "My box won't connect.",
                    "nextQuestion": "UpdateBrowser"
                },
                {
                    "answer": "I'm getting an error message",
                    "nextQuestion": "ErrorMessage"
                }
            ]
        },

        "ErrorMessage": {
            "question": "Expand the 'Serial Monitor' panel at the bottom of the IDE. Look for log messages like these, which do you see?",
            "answers": [
                {
                    "answer": "I see 'stk500 not in sync' errors.",
                    "nextQuestion": "STK500"
                },
                {
                    "answer": "I see normal Arduino errors about the code",
                    "nextQuestion": "NormalErrors"
                },
                {
                    "answer": "I am getting 'exit status: 1' errors with no other context.",
                    "nextQuestion": "DeviceInUse"
                }
            ]
        },
        "DeviceInUse": {
            "question": "First, look through the logs to make sure you are not getting any stk500 messages. If you are, go back and select that. To fix this error, close all other CrunchLabs IDE tabs except one, and make sure you are not running any other IDEs (such as the Arduino IDE) in the background. Try disabling bluetooth and restarting your computer.", 
            "answers": []
        },
        "STK500": {
            "question": "To solve stk500, 1. make sure you are using the provided cable. If you are, try another data cable. If it also gives the same stk500 error, continue to the next point. 2. disable bluetooth and restart your computer. If it still gives the same stk500 error, continue to the next point. 3. the bootloader on your arduino is bad. Either you need to re-flash it using another arduino, or request a replacement from help@crunchlabs.com. You can also request help from the [Hack Pack discord](https://discord.gg/Bz8DSFjMFm)",
            "answers": []
        },
        "NormalErrors": {
            "question": "You most likely need to fix the bugs in your code. You can click Restore Code in Advanced mode at the top to reset the code to a working state.",
            "answers": []
        },

        "UpdateBrowser": {
            "question": "Are you running the latest stable version of Chrome / Firefox? Confirm by going to three-bar menu in top right > Help > About. If an update is available, update, restart the browser, refresh the IDE, and try again.",
            "answers": [
                {
                    "answer": "My browser is up to date, the problem persists.",
                    "nextQuestion": "ExtensionCheck"
                },
                {
                    "answer": "I am using a different browser.",
                    "nextQuestion": "UseChromeOrFirefox"
                }
            ]
        },
        "UseChromeOrFirefox": {
            "question": "You must use either Chrome or Firefox to run the IDE. Some other browsers (such as Brave and Edge) may work, but should not be used while troubleshooting connection issues. Please try again with Chrome or Firefox.",
            "answers": []
        },

        "ExtensionCheck": {
            "question": "Are you using Chrome as your browser, and have you disabled any content-blocking extensions (adblockers, privacy extensions)?",
            "answers": [
                {
                    "answer": "Yes",
                    "nextQuestion": "ProvidedCableCheck"
                }
            ]
        },

        "ProvidedCableCheck": {
            "question": "Are you using the provided USB-C to USB-A cable?",
            "answers": [
                {
                    "answer": "Yes",
                    "nextQuestion": "ArduinoPortCheck"
                }
            ]
        },
        "ArduinoPortCheck": {
            "question": "Are you connecting the cable from your computer to the silver USB-C port on the microcontroller, ***not*** the black breadboard box?",
            "answers": [
                {
                    "answer": "Yes",
                    "nextQuestion": "EnableLocalhostChromePermission"
                }
            ]
        },
        "EnableLocalhostChromePermission" : {
            "question": "On the IDE, to the left of the URL bar is an options icon. Click it, and confirm the permission \"Apps on Device\" is enabled, then try again. Does it work now?",
            "answers": [
                {
                    "answer": "No",
                    "nextQuestion": "TryAnotherCable"
                }
            ]
        },
        "TryAnotherCable": {
            "question": "Try using another data-capable cable. Does it work now?",
            "answers": [
                {
                    "answer": "No",
                    "nextQuestion": "Restart"
                }
            ]
        },
        "Restart": {
            "question": "Disable bluetooth on your computer and restart it. Windows users, start the agent as administrator again. Does it work now?",
            "answers": [
                {
                    "answer": "No",
                    "nextQuestion": "TryIncognito"
                }
            ]
        },
        "TryIncognito": {
            "question": "Try running your browser in Incognito mode so it starts without extensions. Does it work now?",
            "answers": [
                {
                    "answer": "No",
                    "nextQuestion": "OSCheck"
                }
            ]
        },

        "OSCheck" : {
            "question": "What Operating System do you use?",
            "answers": [
                {
                    // Windows needs to go over device manager
                    "answer": "Windows",
                    "nextQuestion": "WindowsDeviceManager"
                },
                {
                    // Mac has nothing left to try
                    "answer": "Mac / Chromebook",
                    "nextQuestion": "RequestHelp"
                },
                {
                    "answer": "Linux",
                    "nextQuestion": "RequestHelp"
                },
                {
                    "answer": "Other",
                    "nextQuestion": "RequestHelp"
                }
                
            ]
        },
        "Linux": {
            "question": "Request help in the [Hack Pack discord](https://discord.gg/Bz8DSFjMFm) or by emailing help@crunchlabs.com",
            "answers": []
        },
        "Other": {
            "question": "Request help in the [Hack Pack discord](https://discord.gg/Bz8DSFjMFm) or by emailing help@crunchlabs.com",
            "answers": []
        },

        "WindowsDeviceManager": {
            "question": "Try opening Device Manager, plug in the arduino, look for anything under USBs and Ports & Coms sections that is marked unknown, other, or USB Serial that could possibly be the arduino. Once you find something you think is it unplug the arduino, if it disappears after a second, then you found it. What is it listed at?",
            "answers": [
                {
                    "answer": "USB-SERIAL CH340",
                    "nextQuestion": "HasDriver"
                },
                {
                    "answer": "USB Serial / Unknown / Communications Port / Other",
                    "nextQuestion": "WindowsInstallDriver"
                }
            ]
        },
        "HasDriver": {
            "question": "Your device is recognizing the Arduino, so the cable, drivers, and ports are all good. Make sure you properly did all the above steps, try running your browser in Incognito mode so it starts without extensions.",
            "answers": [
                { 
                    "answer": "It still doesn't work",
                    "nextQuestion": "RequestHelp"
                }
            ]
        }, 
        "WindowsInstallDriver": {
            "question": "Try installing the CH340 driver from [here](https://www.wch-ic.com/downloads/CH341SER_ZIP.html). Download the driver package, unzip it, run SETUP.EXE as administrator. When it is finished, restart your computer *(this is actually necessary)*. Does it show up as **USB-SERIAL CH340** now?",
            "answers": [
                { 
                    "answer": "No",
                    "nextQuestion": "RequestHelp"
                }
            ]
        },

        "RequestHelp": {
            "question": "Request help in the [Hack Pack discord](https://discord.gg/Bz8DSFjMFm) or by emailing help@crunchlabs.com",
            "answers": []
        }
    }
}